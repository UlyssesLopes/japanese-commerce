# URL pública do site (usada em metadata, canonical e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp que recebe os pedidos, formato internacional, só dígitos
# Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endereço da API Java (produtos, kits, cupons, backoffice). Só servidor.
# Local: http://localhost:8080
BACKEND_URL=

# Prévia com rascunhos: só funciona com a mesma chave em STOREFRONT_PREVIEW_KEY da API.
# Desligar (remover) antes do lançamento.
# CATALOG_SHOW_DRAFTS=true
STOREFRONT_PREVIEW_KEY=

# Segredo que a API usa para avisar o site que o catálogo mudou (POST /api/revalidar).
# Igual a STOREFRONT_REVALIDATE_SECRET da API.
STOREFRONT_REVALIDATE_SECRET=
